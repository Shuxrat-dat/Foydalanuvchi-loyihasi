# =============================================================================
# Foydalanuvchi loyihasi — Atrof-muhit konfiguratsiyasi namunasi
# =============================================================================
# Lokal qiymatlarni bekor qilish uchun ushbu faylni .env.local ga nusxalang:
#   cp .env.example .env.local
# =============================================================================

# Symfony ilova sozlamalari
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share

# CLI buyruqlari uchun standart URI
DEFAULT_URI=http://localhost

# =============================================================================
# MAʼLUMOTLAR BAZASI — SQLite (konfiguratsiyasiz, mahalliy ishlab chiqish uchun tavsiya etiladi)
# =============================================================================
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Staging/production uchun PostgreSQL dan foydalaning:
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"

# Staging/production uchun MySQL dan foydalaning:
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"

# =============================================================================
# CORS — API uchun ruxsat etilgan manbalar
# =============================================================================
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# =============================================================================
# JWT autentifikatsiyasi (LexikJWTAuthenticationBundle)
# JWT kalitlari `npm run dev` yoki `npm run setup` orqali birinchi ishga tushishda avtomatik yaratiladi
# =============================================================================
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

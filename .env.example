# =============================================================================
# Foydalanuvchi loyihasi — Environment Configuration Example
# =============================================================================
# Copy this file to .env.local to override values locally:
#   cp .env.example .env.local
# =============================================================================

# Symfony app settings
APP_ENV=dev
APP_SECRET=ada2729dcfcdb8b83523ed925a51174c
APP_SHARE_DIR=var/share

# Default URI for CLI commands
DEFAULT_URI=http://localhost

# =============================================================================
# DATABASE — SQLite (zero-config, recommended for local dev)
# =============================================================================
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Use PostgreSQL for staging/production:
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"

# Use MySQL for staging/production:
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"

# =============================================================================
# CORS — Allowed origins for the API
# =============================================================================
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# =============================================================================
# JWT Authentication (LexikJWTAuthenticationBundle)
# JWT keys are auto-generated on first run via `npm run dev` or `npm run setup`
# =============================================================================
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=a5b4871c63490ecabbab689b7a96c6dea8a556a7ec1ba159fdaa7389d18bfa72

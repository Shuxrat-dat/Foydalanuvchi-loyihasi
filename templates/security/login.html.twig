{% extends 'base.html.twig' %}

{% block title %}Sign In — Foydalanuvchi loyihasi{% endblock %}

{% block body %}
<div class="max-w-md mx-auto my-6 sm:my-10">
    <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50">
        <div class="text-center mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20 mx-auto mb-3">
                <i class="fa-solid fa-lock text-xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-900">Welcome Back</h2>
            <p class="text-sm text-slate-500 mt-1">Sign in to your user management account</p>
        </div>

        {% if error %}
            <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium flex items-center space-x-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 flex-shrink-0"></i>
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
        {% endif %}

        <!-- Quick 1-Click Demo Logins -->
        <div class="mb-6 p-3.5 bg-slate-50 rounded-xl border border-slate-200">
            <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider block mb-2 text-center">
                <i class="fa-solid fa-wand-magic-sparkles text-amber-500 mr-1"></i> Quick 1-Click Demo Login
            </span>
            <div class="grid grid-cols-3 gap-2">
                <button type="button" onclick="fillCredentials('admin@example.com', 'admin123')" class="p-2 rounded-lg bg-white border border-slate-200 hover:border-purple-300 hover:bg-purple-50/50 text-center transition-all text-xs">
                    <span class="font-bold text-purple-700 block">Admin</span>
                    <span class="text-[10px] text-slate-400 block">admin123</span>
                </button>
                <button type="button" onclick="fillCredentials('manager@example.com', 'manager123')" class="p-2 rounded-lg bg-white border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 text-center transition-all text-xs">
                    <span class="font-bold text-blue-700 block">Manager</span>
                    <span class="text-[10px] text-slate-400 block">manager123</span>
                </button>
                <button type="button" onclick="fillCredentials('user@example.com', 'user123')" class="p-2 rounded-lg bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-100 text-center transition-all text-xs">
                    <span class="font-bold text-slate-700 block">User</span>
                    <span class="text-[10px] text-slate-400 block">user123</span>
                </button>
            </div>
        </div>

        <form method="post" action="{{ path('app_login') }}" class="space-y-4">
            <div>
                <label for="inputEmail" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Email Address</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-envelope text-xs"></i>
                    </span>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="w-full pl-9 pr-3.5 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500" autocomplete="email" required autofocus placeholder="admin@example.com">
                </div>
            </div>

            <div>
                <div class="flex justify-between items-center mb-1">
                    <label for="inputPassword" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">Password</label>
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-lock text-xs"></i>
                    </span>
                    <input type="password" name="password" id="inputPassword" class="w-full pl-9 pr-3.5 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500" autocomplete="current-password" required placeholder="••••••••">
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full py-2.5 px-4 rounded-xl text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 active:scale-95 transition-all shadow-md shadow-brand-500/20">
                Sign In
            </button>
        </form>

        <div class="mt-6 pt-4 border-t border-slate-100 text-center">
            <a href="{{ path('app_user_index') }}" class="text-xs text-brand-600 hover:text-brand-700 font-medium">
                &larr; Back to Public Dashboard
            </a>
        </div>
    </div>
</div>

<script>
    function fillCredentials(email, password) {
        document.getElementById('inputEmail').value = email;
        document.getElementById('inputPassword').value = password;
        showToast(`Filled credentials for ${email}`);
    }
</script>
{% endblock %}

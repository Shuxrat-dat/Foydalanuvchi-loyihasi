<!DOCTYPE html>
<html lang="uz" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Foydalanuvchi loyihasi — Foydalanuvchilarni boshqarish{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>👥</text></svg>">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        [x-cloak] { display: none !important; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="h-full flex flex-col text-slate-800 antialiased">
    <!-- Top Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <a href="{{ path('app_user_index') }}" class="flex items-center space-x-3 group">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
                            <i class="fa-solid fa-users text-lg"></i>
                        </div>
                        <div>
                            <span class="text-lg font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent">Foydalanuvchi</span>
                            <span class="text-xs ml-1.5 px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 font-semibold border border-brand-200">v1.0</span>
                        </div>
                    </a>

                    <nav class="hidden md:flex ml-8 space-x-1">
                        <a href="{{ path('app_user_index') }}" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-brand-600 hover:bg-slate-100 transition-colors flex items-center space-x-1.5">
                            <i class="fa-solid fa-table-columns text-slate-400"></i>
                            <span>Bosh sahifa</span>
                        </a>
                        <a href="/api" target="_blank" class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-brand-600 hover:bg-slate-100 transition-colors flex items-center space-x-1.5">
                            <i class="fa-solid fa-code text-indigo-500"></i>
                            <span>Swagger API</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-400 ml-0.5"></i>
                        </a>
                    </nav>
                </div>

                <div class="flex items-center space-x-3">
                    <a href="/api" target="_blank" class="hidden sm:inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition-colors">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>API Platform 4.3</span>
                    </a>

                    {% if app.user %}
                        <div class="flex items-center space-x-3 border-l border-slate-200 pl-3">
                            <div class="text-right hidden sm:block">
                                <div class="text-sm font-semibold text-slate-800">{{ app.user.fullName }}</div>
                                <div class="text-xs text-slate-500">{{ app.user.primaryRoleLabel }}</div>
                            </div>
                            <div class="w-9 h-9 rounded-full bg-brand-100 text-brand-700 font-bold flex items-center justify-center border border-brand-200 shadow-sm text-sm">
                                {{ app.user.initials }}
                            </div>
                            <a href="{{ path('app_logout') }}" title="Chiqish" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            </a>
                        </div>
                    {% else %}
                        <div class="flex items-center space-x-2">
                            <a href="{{ path('app_login') }}" class="inline-flex items-center space-x-1.5 px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100 transition-colors">
                                <i class="fa-solid fa-arrow-right-to-bracket text-slate-400"></i>
                                <span>Kirish</span>
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-xl p-4 flex items-center justify-between {% if label == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200{% else %}bg-rose-50 text-rose-800 border border-rose-200{% endif %}">
                    <div class="flex items-center space-x-3">
                        <i class="fa-solid {% if label == 'success' %}fa-circle-check text-emerald-500{% else %}fa-circle-exclamation text-rose-500{% endif %} text-lg"></i>
                        <span class="text-sm font-medium">{{ message }}</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-3">
            <div>
                <span class="font-semibold text-slate-700">Foydalanuvchi loyihasi</span> &copy; {{ "now"|date("Y") }}. Barcha huquqlar himoyalangan.
            </div>
            <div class="flex items-center space-x-4">
                <span class="flex items-center space-x-1">
                    <i class="fa-solid fa-bolt text-amber-500"></i>
                    <span>Symfony 7.4</span>
                </span>
                <span class="text-slate-300">•</span>
                <span class="flex items-center space-x-1">
                    <i class="fa-solid fa-database text-blue-500"></i>
                    <span>SQLite (Konfiguratsiyasiz)</span>
                </span>
                <span class="text-slate-300">•</span>
                <a href="/api" target="_blank" class="hover:text-brand-600 transition-colors flex items-center space-x-1 font-medium">
                    <i class="fa-solid fa-book-open text-indigo-500"></i>
                    <span>API Hujjatlari</span>
                </a>
            </div>
        </div>
    </footer>

    <!-- Toast Notification Helper -->
    <script>
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center space-x-3 px-4 py-3 rounded-xl shadow-lg border text-sm font-medium transition-all duration-300 transform translate-y-2 opacity-0 ${
                type === 'success' ? 'bg-white text-slate-800 border-emerald-300 shadow-emerald-500/10' : 'bg-white text-slate-800 border-rose-300 shadow-rose-500/10'
            }`;

            const iconClass = type === 'success' ? 'fa-circle-check text-emerald-500' : 'fa-circle-exclamation text-rose-500';
            toast.innerHTML = `
                <i class="fa-solid ${iconClass} text-base flex-shrink-0"></i>
                <div class="flex-1">${message}</div>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 pl-2">
                    <i class="fa-solid fa-xmark text-xs"></i>
                </button>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
